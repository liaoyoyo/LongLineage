{
  "schema_name": "longlineage.m1_sites",
  "schema_version": "1.0.0",
  "format": "TSV_BGZF",
  "header": [
    "dataset_order",
    "dataset_id",
    "site_order",
    "chrom",
    "pos1",
    "ref",
    "alt",
    "analysis_status",
    "reason",
    "n_alt_joined",
    "n_alt_after_peel",
    "distance_matrix_sha256",
    "coarse_split_trace_sha256",
    "coarse_k",
    "fine_split_trace_sha256",
    "fine_k",
    "non_germline_groups",
    "modal_fraction",
    "modal_assignment_ari_min",
    "modal_assignment_sha256",
    "rng_trace_sha256",
    "stable",
    "hp_exact_axis",
    "hp_family_axis",
    "strand_axis",
    "start_axis",
    "end_axis",
    "length_axis",
    "mapq_axis",
    "cpg_called_axis"
  ],
  "fields": [
    {"name": "dataset_order", "type": "uint32", "required": true},
    {"name": "dataset_id", "type": "string", "required": true},
    {"name": "site_order", "type": "uint64", "required": true},
    {"name": "chrom", "type": "string", "required": true},
    {"name": "pos1", "type": "Position1", "required": true},
    {"name": "ref", "type": "base", "required": true},
    {"name": "alt", "type": "base", "required": true},
    {"name": "analysis_status", "type": "status_code", "required": true},
    {"name": "reason", "type": "reason_code", "required": true},
    {"name": "n_alt_joined", "type": "uint32", "required": true},
    {"name": "n_alt_after_peel", "type": "uint32", "required": true},
    {"name": "distance_matrix_sha256", "type": "sha256", "required": false, "null": "."},
    {"name": "coarse_split_trace_sha256", "type": "sha256", "required": false, "null": "."},
    {"name": "coarse_k", "type": "uint32", "required": false, "null": "."},
    {"name": "fine_split_trace_sha256", "type": "sha256", "required": false, "null": "."},
    {"name": "fine_k", "type": "uint32", "required": false, "null": "."},
    {"name": "non_germline_groups", "type": "uint32", "required": false, "null": "."},
    {"name": "modal_fraction", "type": "float64", "required": false, "null": "."},
    {"name": "modal_assignment_ari_min", "type": "float64", "required": false, "null": "."},
    {"name": "modal_assignment_sha256", "type": "sha256", "required": false, "null": "."},
    {"name": "rng_trace_sha256", "type": "sha256", "required": false, "null": "."},
    {"name": "stable", "type": "bool", "required": true},
    {"name": "hp_exact_axis", "type": "axis_status", "required": true},
    {"name": "hp_family_axis", "type": "axis_status", "required": true},
    {"name": "strand_axis", "type": "axis_status", "required": true},
    {"name": "start_axis", "type": "axis_status", "required": true},
    {"name": "end_axis", "type": "axis_status", "required": true},
    {"name": "length_axis", "type": "axis_status", "required": true},
    {"name": "mapq_axis", "type": "axis_status", "required": true},
    {"name": "cpg_called_axis", "type": "axis_status", "required": true}
  ],
  "axis_status_values": ["NOT_RUN_UNSTABLE", "PASS", "FAIL", "INDETERMINATE"],
  "status_domain_bindings": {
    "analysis_status": "m1",
    "reason": "m1",
    "hp_exact_axis": "m1_axis",
    "hp_family_axis": "m1_axis",
    "strand_axis": "m1_axis",
    "start_axis": "m1_axis",
    "end_axis": "m1_axis",
    "length_axis": "m1_axis",
    "mapq_axis": "m1_axis",
    "cpg_called_axis": "m1_axis"
  },
  "invariants": [
    "coarse and fine null each request 40 replicates and require at least 32 valid",
    "ten PCG64 seeds are consumed in frozen order",
    "the eight axes are evaluated only after stable=true"
  ]
}
