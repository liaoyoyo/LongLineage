  "embedded_json_bindings": {
    "group_allele_counts_json": {
      "schema_id": "https://longlineage.local/schema/group_allele_counts-1.0.0.json",
      "schema_path": "schema/records/group_allele_counts.embedded.schema.json",
      "schema_sha256": "ac292f99b63b01f14d8ced7e9a040082d72e40928f2a31c561d41ed018f73cc7",
      "null_policy": "FORBIDDEN",
      "constraints": [
        {"operator": "ARRAY_LENGTH_EQUALS_FIELD", "field": "group_count"},
        {"operator": "MATRIX_TOTAL_EQUALS_FIELD", "field": "n_informative"},
        {"operator": "MATRIX_COLUMN_SUM_EQUALS_FIELD", "column": 0, "field": "ref_n"},
        {"operator": "MATRIX_COLUMN_SUM_EQUALS_FIELD", "column": 1, "field": "alt_n"},
        {"operator": "MINIMUM_ROW_SUM_EQUALS_FIELD", "field": "min_group_n"},
        {"operator": "CANONICAL_JSON_SHA256_EQUALS_FIELD", "field": "group_allele_counts_sha256"}
      ]
    },
    "compatible_relation_models_json": {
      "schema_id": "https://longlineage.local/schema/compatible_relation_models-1.0.0.json",
      "schema_path": "schema/records/compatible_relation_models.embedded.schema.json",
      "schema_sha256": "f1246d0d0c01bccfb969eda28eb6f410c48331de6b19dd184411d32d65cf7b1a",
      "null_policy": "FORBIDDEN",
      "constraints": [
        {"operator": "ARRAY_LENGTH_EQUALS_FIELD", "field": "n_compatible_relation_models"}
      ]
    }
  },
  "status_domain_bindings": {
    "exact_status": "endpoint_a",
    "conditional_status": "conditional",
    "callability_status": "callability",
    "focal_ancestor_status": "fixed_error_gate",
    "partner_ancestor_status": "fixed_error_gate",
    "branching_status": "fixed_error_gate",
    "compatibility_status": "endpoint_b"
  },
  "invariants": [
    "abs(distance_bp) <= 5000 and focal position is included in the partner universe",
    "n_informative >= 10, every group >= 3, ref_n >= 3 and alt_n >= 3 before exact testing",
    "family_status is INELIGIBLE_M2_SCREEN unless the focal M2 decision is PASS; only ELIGIBLE_M2_EXACT_FAMILY rows enter global exact BH/BY",
    "descriptive exact p may be present outside the formal family, but fdr_family_id, fdr_family_size, q values and exact discoveries are null or false",
    "exact_state_count > 250000 yields NOT_IDENTIFIABLE and p/q fields are null",
    "conditional test requests exactly 999 permutations when its callability gate passes",
    "pair cells are row-major focal-call then partner-call over R,A,O,X",
    "pair_read_count equals the sum of all 16 pair cells",
    "ra_complete_read_count = rr + ra + ar + aa",
    "no O/X-containing pair cell is collapsed, discarded or recoded as R",
    "compatibility is not ancestry, clone identity or temporal ordering"
  ]
}
