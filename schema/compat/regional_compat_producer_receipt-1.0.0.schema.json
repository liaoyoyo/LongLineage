{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://longlineage.local/schema/compat/regional_compat_producer_receipt-1.0.0.json",
  "title": "LongLineage regional compatibility producer receipt (legacy)",
  "type": "object",
  "required": ["schema_name", "schema_version", "run_id", "profile_id", "summary_sha256", "semantic_sha256", "artifacts"],
  "properties": {
    "schema_name": {"const": "longlineage.regional_compat_producer_receipt"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "profile_id": {"const": "PYTHON_V2_DESCRIPTIVE_REGIONAL"},
    "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/summary"},
        {"$ref": "#/$defs/regions"},
        {"$ref": "#/$defs/units"},
        {"$ref": "#/$defs/patterns"}
      ],
      "items": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "rows"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rows": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "summary.json"}, "rows": {"const": 1}}}]},
    "regions": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "regions.tsv"}}}]},
    "units": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "units.tsv"}}}]},
    "patterns": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "patterns.tsv"}}}]}
  },
  "additionalProperties": false
}
