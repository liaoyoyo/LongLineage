      "deviation_id": "CHILD_TASK_PROCESS_DEVIATION",
      "impact": "An early isolated-worktree writer lacked its own child task and non-overlapping lease.",
      "mitigation": "The root agent stopped shared writes, reviewed every path and replayed all twelve checks on one clean detached commit.",
      "claim_effect": "No child result is accepted directly; only the root replay is represented by this receipt."
    },
    {
      "deviation_id": "READ_ONLY_DELEGATION_PROCESS_DEVIATION",
      "impact": "Three read-only delegates also lacked child task records before delivering inventories.",
      "mitigation": "They made no filesystem changes, and the root independently replayed every cited binding and command.",
      "claim_effect": "Their reports are navigation aids only and do not independently establish any PASS claim."
    },
    {
      "deviation_id": "CONCURRENT_SESSION_WRITESET_DEVIATION",
      "impact": "A separate AI session used the root lease to prepare report fixes without an independently visible child write set.",
      "mitigation": "The root avoided simultaneous edits, reviewed both commits and required fresh self-test plus browser QA.",
      "claim_effect": "The concurrent session cannot enlarge scope or production claims and its first failed mobile report remains failed evidence."
    },
    {
      "deviation_id": "LEAK_SANITIZER_DISABLED",
      "impact": "LeakSanitizer is unsupported under the local sandbox tracing boundary.",
