{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://longlineage.local/governance/audit_evidence-1.0.0.json",
  "title": "LongLineage immutable audit evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "snapshot_id",
    "task_id",
    "scope",
    "source_snapshot_kind",
    "source_commit",
    "source_tree_sha256",
    "source_dirty",
    "commands",
    "captured_at",
    "captured_by_agent_id",
    "supersedes",
    "superseded_by",
    "supersession_reason"
  ],
  "properties": {
    "schema_name": {"const": "longlineage.audit_evidence"},
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "#/$defs/snapshot_id"},
    "task_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9][a-z0-9-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "completeness",
        "description",
        "included_paths",
        "excluded_paths"
      ],
      "properties": {
        "kind": {"enum": ["REPOSITORY", "BUILD", "RUN", "ARTIFACT_SET"]},
        "completeness": {"enum": ["PARTIAL", "FULL"]},
        "description": {"type": "string", "minLength": 1},
        "included_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relative_path"}
        },
        "excluded_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relative_path"}
        }
      }
    },
    "source_snapshot_kind": {
      "enum": ["GIT_COMMIT", "GIT_TREE", "UNCOMMITTED_TREE", "VALIDATED_FROZEN_RUN"]
    },
    "source_commit": {
      "description": "Git object ID when available; null is explicit for a pre-init or non-Git snapshot.",
      "type": ["string", "null"],
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "source_tree_sha256": {
      "description": "SHA-256 of the deterministic source-tree manifest, independent of Git object hash algorithm.",
      "$ref": "#/$defs/sha256"
    },
    "source_dirty": {"type": "boolean"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command_evidence"}
    },
    "captured_at": {"type": "string", "format": "date-time"},
    "captured_by_agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}:[A-Za-z0-9][A-Za-z0-9._/-]{0,126}$"
    },
    "supersedes": {
      "description": "Older snapshot IDs made stale by this immutable envelope; this forward edge is authoritative.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/snapshot_id"}
    },
    "superseded_by": {
      "description": "Capture-time reverse-edge hint. Canonical queries derive reverse edges from all supersedes arrays and never back-patch an immutable envelope.",
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/snapshot_id"}
      ]
    },
    "supersession_reason": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {"properties": {"supersedes": {"minItems": 1}}, "required": ["supersedes"]},
          {"properties": {"superseded_by": {"type": "string"}}, "required": ["superseded_by"]}
        ]
      },
      "then": {
        "properties": {
          "supersession_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"source_snapshot_kind": {"enum": ["GIT_COMMIT", "GIT_TREE"]}},
        "required": ["source_snapshot_kind"]
      },
      "then": {
        "properties": {
          "source_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9][a-z0-9-]*-[0-9]{3}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "command_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "argv",
        "working_directory",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "argv": {
          "description": "Exact argv; no shell interpolation or implicit working directory.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "working_directory": {"$ref": "#/$defs/relative_path"},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "stdout_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "stderr_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "x-longlineage-invariants": [
    "snapshot_id differs from every supersedes entry and from superseded_by",
    "source_tree_sha256 is recomputed from a canonical repository-relative path, file-size and file-SHA256 manifest",
    "command_id values are unique and command completion is not earlier than command start",
    "supersession edges are acyclic; reverse edges are derived from immutable forward supersedes edges",
    "phase evidence references the immutable envelope path and physical SHA-256, never mutable prose alone",
    "FULL scope declares every intentional exclusion and no command runs outside the declared source snapshot"
  ]
}
